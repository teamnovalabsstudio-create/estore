DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/estore"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/estore_test"
SEED_ADMIN_EMAIL="admin@estore.test"
SEED_ADMIN_PASSWORD="change-me-please"

# Public base URL (used for canonical/OG URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# HMAC key for OTP hashes, verified-phone cookie, order links (openssl rand -base64 48)
APP_SECRET="replace-with-at-least-32-random-characters"
# Bearer token for /api/cron/* (openssl rand -hex 24)
CRON_SECRET="replace-me-with-random-hex"

# OTP delivery: console (dev, code is logged/shown) | whatsapp (Cloud API, SMS fallback)
MESSAGING_DRIVER="console"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_OTP_TEMPLATE="otp_code"
SMS_API_URL=""
SMS_API_KEY=""

# Online payments: mock (local simulator, non-production) | safepay | payfast
PAYMENT_ONLINE_PROVIDER="mock"
SAFEPAY_ENV="sandbox"
SAFEPAY_API_KEY=""
SAFEPAY_WEBHOOK_SECRET=""

# Local receipt storage (gitignored)
UPLOAD_DIR="storage/uploads"

# WhatsApp order confirmations (M5): template + reply webhook at /api/webhooks/whatsapp
WHATSAPP_CONFIRM_TEMPLATE="order_confirmation"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
